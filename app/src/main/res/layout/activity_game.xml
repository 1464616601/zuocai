<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/gameBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/game_back"
            android:padding="9dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gameLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_tertiary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_score_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_score_label"
                android:textColor="@color/text_tertiary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/gameScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:minWidth="34dp"
                android:text="0"
                android:textAlignment="viewEnd"
                android:textColor="@color/brand"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_score_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_best_label"
                android:textColor="@color/text_tertiary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/gameBest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:minWidth="34dp"
                android:text="0"
                android:textAlignment="viewEnd"
                android:textColor="@color/text_secondary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 画布 -->
    <com.jiangjinhao.zuocai.ui.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_game_stage"
        android:clipToOutline="true" />

    <!-- 控制台 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#17130F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="3">

            <ImageView
                android:id="@+id/padUp"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_pad_btn"
                android:contentDescription="@string/game_up"
                android:elevation="2dp"
                android:padding="16dp"
                android:src="@drawable/ic_arrow_up" />

            <ImageView
                android:id="@+id/padLeft"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_margin="3dp"
                android:background="@drawable/bg_pad_btn"
                android:contentDescription="@string/game_left"
                android:elevation="2dp"
                android:padding="16dp"
                android:src="@drawable/ic_arrow_left" />

            <ImageView
                android:id="@+id/padRight"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_row="1"
                android:layout_column="2"
                android:layout_margin="3dp"
                android:background="@drawable/bg_pad_btn"
                android:contentDescription="@string/game_right"
                android:elevation="2dp"
                android:padding="16dp"
                android:src="@drawable/ic_arrow_right" />

            <ImageView
                android:id="@+id/padDown"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_margin="3dp"
                android:background="@drawable/bg_pad_btn"
                android:contentDescription="@string/game_down"
                android:elevation="2dp"
                android:padding="16dp"
                android:src="@drawable/ic_arrow_down" />
        </GridLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnA"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/bg_act_btn"
                android:elevation="4dp"
                android:gravity="center"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="@string/game_a"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnB"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_act_btn_alt"
                android:elevation="4dp"
                android:gravity="center"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="@string/game_b"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
